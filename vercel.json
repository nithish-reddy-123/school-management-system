{
  "version": 2,
  "functions": {
    "api/index.js": {
      "runtime": "nodejs22.x"
    }
  },
  "env": {
    "NODE_OPTIONS": "--experimental-sqlite --disable-warning=ExperimentalWarning",
    "DB_PATH": "/tmp/school-management.db"
  },
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/api/index.js"
    }
  ]
}