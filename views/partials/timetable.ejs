<div class="table-wrap">
  <table class="table timetable">
    <thead>
      <tr><th>Day</th><% timetable.periods.forEach(function (p) { %><th>P<%= p %></th><% }) %></tr>
    </thead>
    <tbody>
      <% for (let d = 1; d <= 6; d++) { %>
        <tr>
          <th><%= timetable.days[d] %></th>
          <% timetable.periods.forEach(function (p) { const slot = timetable.grid[d][p]; %>
            <td class="<%= slot ? 'slot' : 'free' %>">
              <% if (slot) { %><strong><%= slot.subject %></strong><small><%= slot.teacher || '' %></small><% } else { %>–<% } %>
            </td>
          <% }) %>
        </tr>
      <% } %>
    </tbody>
  </table>
</div>
