<%- include('../partials/header') %>
<%- include('../partials/page_head', { ph: { title: t('changePassword'), icon: 'key', sub: 'Choose a strong password you have not used elsewhere.' } }) %>
<section class="card narrow-form">
  <% if (user.must_change_password) { %>
    <div class="callout callout-info"><%- icon('info') %><div>You are using a temporary password. Please set your own password to continue.</div></div>
  <% } %>
  <% if (error) { %><div class="callout callout-bad" role="alert"><%- icon('alert') %><div><%= error %></div></div><% } %>
  <form method="post" action="/change-password">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <label>Current password
      <input type="password" name="current_password" required autocomplete="current-password">
    </label>
    <label>New password
      <input type="password" name="new_password" required minlength="8" autocomplete="new-password">
      <small class="muted">At least 8 characters, with letters and numbers. Must not contain your username.</small>
    </label>
    <label>Confirm new password
      <input type="password" name="confirm_password" required minlength="8" autocomplete="new-password">
    </label>
    <button class="btn btn-lg btn-block" type="submit"><%- icon('check-circle') %> <%= t('save') %></button>
  </form>
</section>
<%- include('../partials/footer') %>
