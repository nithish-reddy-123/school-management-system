<%- include('../partials/header') %>
<%- include('../partials/page_head', { ph: { title: t('grievances'), icon: 'message', sub: 'Raise a concern or suggestion and track the school\'s response.' } }) %>
<div class="grid grid-side">
  <section class="card">
    <h2><%- icon('clipboard') %> My submissions</h2>
    <% if (!mine.length) { %><%- include('../partials/empty', { e: { icon: 'message', title: 'Nothing submitted yet', text: 'Your grievances and suggestions will appear here with the school\'s response.' } }) %><% } %>
    <% mine.forEach(function (g) { %>
      <article class="grievance">
        <div class="card-head">
          <strong><%= g.subject %></strong>
          <span class="badge st-<%= g.status %>"><%= g.status.replace('_', ' ') %></span>
        </div>
        <small class="muted"><%= g.category %> · <%= utils.formatDate(g.created_at) %></small>
        <p><%= g.description %></p>
        <% if (g.response) { %><div class="response"><strong>School response:</strong> <%= g.response %></div><% } %>
      </article>
    <% }) %>
  </section>
  <section class="card form-panel">
    <h2><%- icon('plus') %> Raise a grievance or suggestion</h2>
    <form method="post" action="/grievances">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <label>Category
        <select name="category"><% categories.forEach(function (c) { %><option><%= c %></option><% }) %></select>
      </label>
      <label>Subject <input name="subject" required maxlength="150"></label>
      <label>Details <textarea name="description" rows="5" required maxlength="4000"></textarea></label>
      <label class="check"><input type="checkbox" name="anonymous" value="1"> Submit anonymously</label>
      <p class="muted small">Anonymous submissions are not linked to your account at all, so you will not be able to track the response here.</p>
      <button class="btn btn-block" type="submit"><%- icon('send') %> Submit</button>
    </form>
  </section>
</div>
<%- include('../partials/footer') %>
