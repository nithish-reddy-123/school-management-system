{
  "name": "school_management_system",
  "version": "1.0.0",
  "private": true,
  "description": "School management system for Indian government schools with role-based access for headmasters, teachers, students and parents",
  "main": "src/server.js",
  "scripts": {
    "start": "node --experimental-sqlite --disable-warning=ExperimentalWarning src/server.js",
    "dev": "node --watch --experimental-sqlite --disable-warning=ExperimentalWarning src/server.js",
    "seed": "node --experimental-sqlite --disable-warning=ExperimentalWarning src/seed.js",
    "seed:reset": "node --experimental-sqlite --disable-warning=ExperimentalWarning src/seed.js --reset"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "dotenv": "^18.0.9",
    "ejs": "^7.0.2",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.3",
    "express-session": "^1.19.0",
    "helmet": "^8.3.0",
    "multer": "^2.5.0"
  }
}
