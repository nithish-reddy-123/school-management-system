# Copy this file to .env and change the values.
PORT=3000
# Required in production. Use a long random string, e.g. output of:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string
# Set to "production" when deployed behind HTTPS (enables secure cookies).
NODE_ENV=development
# Optional: custom SQLite database location
# DB_PATH=./data/school.db
