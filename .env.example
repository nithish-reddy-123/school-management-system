# Copy this file to .env and change the values.
PORT=3000
# Required in production. Use a long random string, e.g. output of:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string
# Set to "production" when deployed behind HTTPS (enables secure cookies).
NODE_ENV=development
# MongoDB connection. Required in production; in development it defaults to a local server.
#   Local:  mongodb://127.0.0.1:27017
#   Atlas:  mongodb+srv://username:password@cluster.example.mongodb.net/
MONGODB_URI=mongodb://127.0.0.1:27017
# Database name (default: the name in the URI path, otherwise school_management)
MONGODB_DB=school_management
# Time zone for dates and times (default Asia/Kolkata, whatever the server's own time zone is)
# APP_TIMEZONE=Asia/Kolkata
